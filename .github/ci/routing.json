{
  "scopes": {
    "home": ["home-checks", "width-check"],
    "agentshed": ["agentshed-checks", "width-check"],
    "justsnap": ["justsnap-checks", "width-check"],
    "transfer": ["transfer-checks", "width-check"],
    "site_kit": ["site-kit-checks"],
    "pages_deploy": ["pages-deploy-checks"],
    "download_count": ["download-count-checks"]
  },
  "rules": [
    {
      "reason": "Shared input",
      "select": "all",
      "paths": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "packages/**"]
    },
    {
      "reason": "Documentation",
      "select": [],
      "paths": [
        "README.md",
        "AGENTS.md",
        "docs/agents/*.md",
        "docs/adr/*.md",
        "docs/specs/*.md",
        "docs/ops/*.md",
        "docs/assets/**",
        "docs/prototypes/**"
      ]
    },
    {
      "reason": "Homepage",
      "select": ["home"],
      "paths": ["apps/home/**"]
    },
    {
      "reason": "Agentshed's site",
      "select": ["agentshed"],
      "paths": ["apps/agentshed/**"]
    },
    {
      "reason": "JustSnap's site",
      "select": ["justsnap"],
      "paths": ["apps/justsnap/**"]
    },
    {
      "reason": "Transfer's site",
      "select": ["transfer"],
      "paths": ["apps/transfer/**"]
    },
    {
      "reason": "The download count's Worker",
      "select": ["download_count"],
      "paths": ["workers/download-count/**"]
    }
  ]
}
