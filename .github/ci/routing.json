{
  "scopes": {
    "home": ["home-checks", "width-check"],
    "agentshed": ["agentshed-checks", "width-check"]
  },
  "rules": [
    {
      "reason": "Shared input",
      "select": "all",
      "paths": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "packages/**"]
    },
    {
      "reason": "Documentation",
      "select": [],
      "paths": [
        "README.md",
        "AGENTS.md",
        "docs/agents/*.md",
        "docs/adr/*.md",
        "docs/specs/*.md",
        "docs/ops/*.md",
        "docs/assets/**",
        "docs/prototypes/**"
      ]
    },
    {
      "reason": "Homepage",
      "select": ["home"],
      "paths": ["apps/home/**"]
    },
    {
      "reason": "Agentshed's site",
      "select": ["agentshed"],
      "paths": ["apps/agentshed/**"]
    }
  ]
}
