{
  "name": "aloong-planet-home",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "build": "node scripts/build.mjs",
    "dev": "wrangler pages dev dist --ip 127.0.0.1 --port 8793",
    "db:local": "wrangler d1 migrations apply VISITORS --local",
    "check": "node scripts/verify.mjs",
    "cf:login": "wrangler login --scopes account:read user:read pages:write d1:write --use-keyring",
    "cf:deploy": "node scripts/deploy.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.1"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=26.7.0"
  }
}
